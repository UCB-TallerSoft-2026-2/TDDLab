# syntax=docker/dockerfile:1.7

############################
# Build del frontend
############################
FROM docker.io/oven/bun:1.4.0-alpine AS builder

WORKDIR /build

COPY ["Web Ui/package.json", "Web Ui/bun.lock*", "./"]

RUN bun install --frozen-lockfile || bun install

COPY ["Web Ui/", "./"]

# Declarar ARG para que Vite lea la variable durante bun run build
ARG VITE_USE_FIREBASE_EMULATOR=true
ENV VITE_USE_FIREBASE_EMULATOR=$VITE_USE_FIREBASE_EMULATOR

RUN bun run build

############################
# Runtime Firebase Emulator
############################
FROM docker.io/oven/bun:1.4.0-alpine

ARG FIREBASE_TOOLS_VERSION=14.16.0

RUN apk add --no-cache \
    openjdk21-jre \
    bash \
    tini \
 && bun add -g firebase-tools@${FIREBASE_TOOLS_VERSION}

WORKDIR /app

COPY ["Web Ui/firebase.staging.json", "./firebase.json"]
COPY ["Web Ui/.firebaserc", "./"]

COPY --from=builder /build/dist ./dist

EXPOSE 4000 5000 9099

ENTRYPOINT ["/sbin/tini", "--"]

# La vinculación a 0.0.0.0 debe estar configurada dentro de firebase.json
CMD ["firebase", "emulators:start", "--only", "hosting,auth", "--project", "staging"]
